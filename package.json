{
  "name": "zh-translator",
  "version": "1.0.0",
  "private": true,
  "description": "Chinese ↔ English translator with an offline pinyin input method",
  "scripts": {
    "start": "node server.js",
    "build-dict": "node scripts/build-dict.js",
    "test": "node test/lookup.test.js",
    "sync-docs": "node -e \"const fs=require('fs');fs.rmSync('docs',{recursive:true,force:true});fs.cpSync('public','docs',{recursive:true});fs.copyFileSync('NOTICE.md','docs/NOTICE.md');fs.copyFileSync('NOTICE.md','public/NOTICE.md');fs.writeFileSync('docs/.nojekyll','')\""
  }
}
